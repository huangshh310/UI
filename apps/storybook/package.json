{
  "name": "@matt-ui/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "开发期的组件工作台：展示每个组件的各种状态。不是面向使用者的文档站。",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006",
    "build": "storybook build --output-dir storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@matt-ui/motion": "workspace:*",
    "@matt-ui/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
