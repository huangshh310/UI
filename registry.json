    {
      "name": "book-call-button",
      "type": "registry:ui",
      "title": "Book Call Button",
      "description": "A pill whose accent capsule expands on hover to reveal a phone icon.",
      "categories": ["buttons"],
      "dependencies": ["lucide-react"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/ui/book-call-button.tsx",
          "type": "registry:ui",
          "target": "@ui/book-call-button.tsx"
        }
      ],
      "cssVars": {
        "light": {
          "signal": "oklch(0.9 0.2 125)",
          "signal-foreground": "oklch(0.145 0.004 286)",
          "destructive-foreground": "oklch(0.985 0.004 286)"
        },
        "dark": {
          "signal": "oklch(0.9 0.2 125)",
          "signal-foreground": "oklch(0.145 0.004 286)",
          "destructive-foreground": "oklch(0.178 0.004 286)"
        }
      },
      "css": {
        "@layer base": {
          ":root": {
            "--ui-duration-instant": "80ms",
            "--ui-duration-fast": "140ms",
            "--ui-duration-normal": "220ms",
            "--ui-duration-slow": "360ms",
            "--ui-ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
            "--ui-ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
            "--ui-ease-in": "cubic-bezier(0.7, 0, 0.84, 0)",
            "--ui-ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
          }
        }
      }
    },
