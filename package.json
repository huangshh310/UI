{
  "name": "matt-ui",
  "private": true,
  "description": "React-first 的现代 UI 组件平台：设计 Token、组件、Registry。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangshh310/UI.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:consumer": "node scripts/consumer-fixture.mjs",
    "registry:generate": "node scripts/generate-registry.mjs && prettier --write registry registry.json",
    "registry:check": "pnpm registry:generate && git diff --exit-code -- registry registry.json",
    "test:registry": "node scripts/registry-fixture.mjs",
    "component:new": "node scripts/component-new.mjs",
    "dev": "pnpm --filter @matt-ui/docs dev",
    "site": "turbo run build --filter=@matt-ui/docs... && pnpm --filter @matt-ui/docs exec next start --port 3000"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
